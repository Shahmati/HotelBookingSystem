<Page x:Class="HotelBookingSystem.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HotelBookingSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1">

    <Grid>
        <WrapPanel>
            <TextBlock Text="Номер" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250"/>
            <TextBox x:Name="tbNum" Style="{StaticResource TbxEditAdd}" Text="{Binding RoomNumber}" Width="250"/>
        </WrapPanel>
    </Grid>
</Page>
