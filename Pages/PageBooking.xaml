<Page x:Class="HotelBookingSystem.Pages.PageBooking"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HotelBookingSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="PageBooking">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Background="Wheat" x:Name="GrdHeader">
            <Label Content="Бронирование" Style="{StaticResource LblHeader}"/>
        </Grid>

        <StackPanel Grid.Row="1">
            <WrapPanel>
                <TextBlock Text="Пользователь" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250"/>
                <ComboBox x:Name="cmbUser" Style="{StaticResource CmbEditAdd}" SelectedItem="{Binding Users}" DisplayMemberPath="FullName" Text="{Binding Users.FullName}"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Комната" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250"/>
                <ComboBox x:Name="cmbRoom" Style="{StaticResource CmbEditAdd}" SelectedItem="{Binding Rooms}" DisplayMemberPath="RoomNumber" Text="{Binding Rooms.RoomNumber}"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Дата заселения" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250"/>
                <TextBox x:Name="tbCheckInDate" Style="{StaticResource TbxEditAdd}" Text="{Binding CheckInDate, StringFormat='dd.MM.yyyy'}"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Дата выселения" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250"/>
                <TextBox x:Name="tbCheckOutDate" Style="{StaticResource TbxEditAdd}" Text="{Binding CheckOutDate, StringFormat='dd.MM.yyyy'}"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Цена" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250"/>
                <TextBox x:Name="tbPrice" Style="{StaticResource TbxEditAdd}" Text="{Binding TotalPrice}"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Кол-во гостей" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250"/>
                <TextBox x:Name="tbGuests" Style="{StaticResource TbxEditAdd}" Text="{Binding NumberOfGuests}"/>
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="Пожелания" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250" VerticalAlignment="Top"/>
                <TextBox x:Name="tbRequests" Style="{StaticResource TbxEditAdd}" Text="{Binding SpecialRequests}" TextWrapping="Wrap" Height="150"/>
            </WrapPanel>
            <Button Style="{StaticResource BtnSignIn}" Margin="0,50,0,0" Background="Wheat" Width="250" Height="50" Content="Сохранить" x:Name="btnSave" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Page>
