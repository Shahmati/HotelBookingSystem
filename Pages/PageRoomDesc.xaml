<Page x:Class="HotelBookingSystem.Pages.PageRoomDesc"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HotelBookingSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="PageRoomDesc">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Background="Wheat" x:Name="GrdHeader">
            <Label Content="Бронирование" Style="{StaticResource LblHeader}"/>
            <Button x:Name="btnBack" Content="Назад" Style="{StaticResource BtnPages}" Background="Red" HorizontalAlignment="Right" Margin="10" Click="btnBack_Click"/>
        </Grid>
        <StackPanel Grid.Row="1" Width="1200" HorizontalAlignment="Center">
            <WrapPanel>
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Номер" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250"/>
                        <TextBox x:Name="tbNum" Style="{StaticResource TbxEditAdd}" Text="{Binding RoomNumber}" Width="250"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="Тип" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250"/>
                        <TextBox x:Name="tbType" Style="{StaticResource TbxEditAdd}" Text="{Binding RoomTypes.TypeName}" Width="250"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="Этаж" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250"/>
                        <TextBox x:Name="tbFloor" Style="{StaticResource TbxEditAdd}" Text="{Binding Floor}" Width="250"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="Цена" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250"/>
                        <TextBox x:Name="tbPrice" Style="{StaticResource TbxEditAdd}" Text="{Binding RoomTypes.BasePrice}" Width="250"/>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock Text="Макс. вместимость" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250"/>
                        <TextBox x:Name="tbMaxOccupancy" Style="{StaticResource TbxEditAdd}" Text="{Binding RoomTypes.MaxOccupancy}" Width="250"/>
                    </WrapPanel>
                </StackPanel>
                <Image Width="250" Margin="150,15,15,15">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="/Resources/standart.jpg"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RoomTypes.RoomTypeId}" Value="1">
                                    <Setter Property="Source" Value="/Resources/standart.jpg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RoomTypes.RoomTypeId}" Value="2">
                                    <Setter Property="Source" Value="/Resources/comfort.jpg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RoomTypes.RoomTypeId}" Value="3">
                                    <Setter Property="Source" Value="/Resources/luxe.jpg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RoomTypes.RoomTypeId}" Value="4">
                                    <Setter Property="Source" Value="/Resources/aparts.jpg"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RoomTypes.RoomTypeId}" Value="5">
                                    <Setter Property="Source" Value="/Resources/family.jpg"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </WrapPanel>
            
            <WrapPanel>
                <TextBlock Text="Описание" Style="{StaticResource TblEditAdd}" HorizontalAlignment="Left" Width="250" VerticalAlignment="Top"/>
                <TextBox x:Name="tbPassword" Style="{StaticResource TbxEditAdd}" Text="{Binding RoomTypes.Description}" TextWrapping="Wrap" Width="900" Height="150"/>
            </WrapPanel>
            <Button Style="{StaticResource BtnSignIn}" Margin="0,50,0,0" Background="Wheat" Width="250" Height="50" Content="Забронировать" x:Name="btnBron" Click="btnBron_Click"/>
        </StackPanel>
    </Grid>
</Page>
